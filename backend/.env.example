# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://localhost:5432/signalhunter

# --- Frontend origin (CORS) ---
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Encrypts API keys users enter in Settings (generated into .secret_key if empty)
SECRET_KEY=
# Allow localhost/private base URLs for "OpenAI-compatible" (e.g. Ollama). Keep false on shared servers.
ALLOW_PRIVATE_BASE_URLS=false

# --- Server-default AI (optional: users can connect their own in Settings) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Smart model: planning, opportunity synthesis, debate. Fast model: extraction/clustering.
LLM_MODEL_SMART=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# --- Search provider ---
# auto = first configured of: tavily -> brave -> anthropic (Claude web search, uses ANTHROPIC_API_KEY)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
# Claude web search tool version (must be enabled for your Anthropic org)
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# --- Research limits ---
RESEARCH_MAX_QUERIES=6
RESEARCH_RESULTS_PER_QUERY=6
RESEARCH_MAX_SOURCES=24
FETCH_TIMEOUT_SECONDS=10
RESPECT_ROBOTS_TXT=true
MAX_DISCOVERIES_PER_HOUR=20
